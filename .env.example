# ============================================================================
# NEXA — environment variables
# Copy this file to `.env` and fill in the values, then restart `npm run dev`.
# ============================================================================

# ---- Supabase (REQUIRED for real auth + real data) ------------------------
# Find these in your Supabase dashboard:
#   Project Settings -> API
#   - Project URL       -> VITE_SUPABASE_URL
#   - Project API keys -> "anon" "public" key -> VITE_SUPABASE_ANON_KEY
#
# The anon key is safe to expose in the browser — Row Level Security (set up
# by supabase/schema.sql) is what actually protects the data.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# If BOTH of the above are left blank, the app automatically falls back to a
# local, no-backend demo mode (bundled sample data + localStorage). Handy for
# a quick look, but there is no real login or persistence in that mode.

# ---- NEXA AI assistant (OPTIONAL) -----------------------------------------
# Without these, the assistant runs in its built-in deterministic demo mode
# (src/lib/nexaMock.js), which is fully functional and needs no key.
#
# SECURITY WARNING: setting VITE_NEXA_AI_API_KEY bundles that key into
# client-side JavaScript, visible to anyone who opens dev tools. Use it only
# for local experimentation. For production, proxy the request through your
# own backend and never ship a private key to the browser.
# VITE_NEXA_AI_API_KEY=
# VITE_NEXA_AI_BASE_URL=https://api.openai.com/v1/chat/completions
# VITE_NEXA_AI_MODEL=gpt-4o-mini

